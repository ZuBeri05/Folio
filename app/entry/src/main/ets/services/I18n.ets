  static t(lang: string, key: string, a?: string | number, b?: string | number): string {
    let table: Map<string, string> = I18n.zh;
    if (lang === 'en') {
      table = I18n.en;
    } else if (lang === 'ja') {
      table = I18n.ja;
    } else if (lang === 'ko') {
      table = I18n.ko;
    } else if (lang === 'fr') {
      table = I18n.fr;
    } else if (lang === 'es') {
      table = I18n.es;
    }
    let value: string | undefined = table.get(key);
    if (value === undefined) {
      value = I18n.en.get(key);
    }
    if (value === undefined) {
      value = key;
    }
    if (a !== undefined) {
      value = value.replace('{0}', String(a));
    }
    if (b !== undefined) {
      value = value.replace('{1}', String(b));
    }
    return value;
  }

  private static pad(value: number): string {
    return value < 10 ? '0' + value : '' + value;
  }

  private static months(lang: string): string[] {
    if (lang === 'en') {
      return ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];
    }
    if (lang === 'ja') {
      return ['1月', '2月', '3月', '4月', '5月', '6月',
        '7月', '8月', '9月', '10月', '11月', '12月'];
    }
    if (lang === 'ko') {
      return ['1월', '2월', '3월', '4월', '5월', '6월',
        '7월', '8월', '9월', '10월', '11월', '12월'];
    }
    if (lang === 'fr') {
      return ['janvier', 'février', 'mars', 'avril', 'mai', 'juin',
        'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
    }
    if (lang === 'es') {
      return ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
        'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    }
    return ['1 月', '2 月', '3 月', '4 月', '5 月', '6 月',
      '7 月', '8 月', '9 月', '10 月', '11 月', '12 月'];
  }

  private static weekdays(lang: string): string[] {
    if (lang === 'en') {
      return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    }
    if (lang === 'ja') {
      return ['日', '月', '火', '水', '木', '金', '土'];
    }
    if (lang === 'ko') {
      return ['일', '월', '화', '수', '목', '금', '토'];
    }
    if (lang === 'fr') {
      return ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];
    }
    if (lang === 'es') {
      return ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
    }
    return ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  }

  /** 紧凑日期：10.24 / 10/24 / 24/10 */
  static dateShort(lang: string, ts: number): string {
    const d = new Date(ts);
    const month = d.getMonth() + 1;
    const day = d.getDate();
    if (lang === 'zh') {
      return I18n.pad(month) + '.' + I18n.pad(day);
    }
    if (lang === 'fr' || lang === 'es') {
      return I18n.pad(day) + '/' + I18n.pad(month);
    }
    return I18n.pad(month) + '/' + I18n.pad(day);
  }

  /** 完整日期：10 月 24 日 / October 24 / 24 octobre */
  static dateLong(lang: string, ts: number): string {
    const d = new Date(ts);
    const month = I18n.months(lang)[d.getMonth()];
    const day = d.getDate();
    if (lang === 'en') {
      return month + ' ' + day;
    }
    if (lang === 'fr') {
      return day + ' ' + month;
    }
    if (lang === 'es') {
      return day + ' de ' + month;
    }
    if (lang === 'ko') {
      return month + ' ' + day + '일';
    }
    if (lang === 'ja') {
      return month + day + '日';
    }
    return month + ' ' + day + ' 日';
  }

  /** 星期：周一 / Mon / 月 / 월 */
  static weekday(lang: string, ts: number): string {
    return I18n.weekdays(lang)[new Date(ts).getDay()];
  }

  static locale(lang: string): string {
    for (let i = 0; i < I18n.languages.length; i++) {
      if (I18n.languages[i].code === lang) {
        return I18n.languages[i].locale;
      }
    }
    return 'zh-CN';
  }
